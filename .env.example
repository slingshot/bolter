# ---------------------------------------------------------------------------
# S3/R2 Storage (required)
#
# S3_BUCKET and S3_ENDPOINT are validated at startup — the backend refuses to
# boot (exit code 1) if either is missing or empty outside of NODE_ENV=test.
#
# The bucket ALSO needs a browser CORS policy and a lifecycle rule; see
# "Operational requirements" at the bottom of this file.
# ---------------------------------------------------------------------------
# S3_BUCKET=your-bucket-name
# S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
# S3_USE_PATH_STYLE_ENDPOINT=true
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Redis (optional - uses local Redis container by default)
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Server
#
# NODE_ENV is validated against development | production | test. Anything else
# — including leaving it unset — is treated as production, which means CORS
# will NOT reflect arbitrary origins and will not allow credentials.
# Set NODE_ENV=development for local work so the API accepts the Vite dev
# server origin, or list it explicitly in CORS_ORIGINS.
# ---------------------------------------------------------------------------
# PORT=3001
# BASE_URL=http://localhost:3001
# NODE_ENV=production
# DETECT_BASE_URL=true

# Extra browser origins allowed by CORS, comma separated. BASE_URL is always
# allowed. Required in production whenever the frontend is served from a
# different origin than the API (e.g. https://send.fm vs https://api.send.fm).
# CORS_ORIGINS=https://send.fm,https://www.send.fm

# ---------------------------------------------------------------------------
# Limits (optional - sensible defaults provided)
#
# Every numeric variable is parsed strictly at startup: non-numeric, fractional,
# negative or out-of-range values abort the boot with an explicit message.
# Values are plain integers — `10GB`, `6months` etc. are rejected, not
# truncated.
# ---------------------------------------------------------------------------
# MAX_FILE_SIZE=1000000000000        # 1 TB
# MAX_FILES_PER_ARCHIVE=64
# MAX_EXPIRE_SECONDS=15552000        # 6 months
# MAX_DOWNLOADS=100

# Defaults (optional) — must not exceed the matching MAX_* value
# DEFAULT_EXPIRE_SECONDS=86400       # 1 day
# DEFAULT_DOWNLOADS=1
# EXPIRE_TIMES_SECONDS=300,3600,86400,604800,1209600,2592000,7776000,15552000
# DOWNLOAD_COUNTS=1,2,3,4,5,20,50,100

# UI Customization (optional)
# CUSTOM_TITLE=Slingshot Send
# CUSTOM_DESCRIPTION=Encrypt and send files with a link that automatically expires.

# Storage Provider Management (optional)
# PROVIDER_ENCRYPTION_KEY=           # 32-byte hex key for encrypting provider secrets in Redis
# PROVIDER_CACHE_TTL_SECONDS=60      # In-memory provider cache refresh interval
# ADMIN_API_KEY=                     # Bearer token for provider CRUD API (/providers/*)

# ---------------------------------------------------------------------------
# Analytics proxy (/pl/api/event → plausible.io)
# ---------------------------------------------------------------------------
# Site domains this deployment may report events for, comma separated. Events
# whose `d` field is not in this list are rejected with 403 so the proxy cannot
# be used to launder fake traffic onto third-party sites from the server's IP.
# PLAUSIBLE_DOMAINS=send.fm

# CIDR ranges of the edge tier allowed to set `cf-connecting-ip` (Cloudflare's
# published ranges, or your ingress proxy). When set, `cf-connecting-ip` is only
# trusted if the request's peer address falls inside one of these ranges;
# otherwise the proxy falls back to `x-forwarded-for`. Leave unset to keep the
# legacy behaviour of always preferring `cf-connecting-ip`.
# TRUSTED_EDGE_CIDRS=173.245.48.0/20,103.21.244.0/22,2400:cb00::/32

# Frontend build args (optional)
# VITE_APP_TITLE=Slingshot Send
# VITE_APP_DESCRIPTION=Encrypt and send files with a link that automatically expires.

# ---------------------------------------------------------------------------
# Operational requirements (bucket-side — NOT environment variables)
# ---------------------------------------------------------------------------
#
# 1. Bucket CORS policy. The browser uploads and downloads directly against the
#    bucket, and it READS response headers that S3/R2 only expose when the CORS
#    policy says so. Without `ExposeHeaders`, `/health` still reports healthy
#    but every multipart upload fails after transferring all its bytes (the
#    `ETag` read at part completion) and every interrupted download fails to
#    range-resume (the `Content-Range` read).
#
#    [
#      {
#        "AllowedOrigins": ["https://send.fm"],
#        "AllowedMethods": ["PUT", "GET", "HEAD"],
#        "AllowedHeaders": ["*"],
#        "ExposeHeaders": ["ETag", "Content-Range", "Content-Length", "Accept-Ranges"],
#        "MaxAgeSeconds": 3600
#      }
#    ]
#
#    Set AllowedOrigins to the frontend origin(s) — the same list as
#    CORS_ORIGINS, plus http://localhost:3000 for local development.
#
# 2. Lifecycle rule: AbortIncompleteMultipartUpload. Interrupted multipart
#    uploads leave parts in the bucket that are invisible to LIST and billed
#    forever; nothing in the application aborts them. Configure a rule such as:
#
#    {
#      "Rules": [
#        {
#          "ID": "abort-incomplete-multipart",
#          "Status": "Enabled",
#          "Filter": { "Prefix": "" },
#          "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 7 }
#        }
#      ]
#    }
