{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["bun"],
        // No explicit `lib`: the default for this target includes DOM, which is
        // where BufferSource, RequestInfo and the stream types come from. Bun
        // implements all of them; restricting the lib only hides them from the
        // compiler while @bolter/protocol still uses them.
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        // Ink's components are ordinary React components, so JSX resolves
        // against React's own runtime. (OpenTUI used to supply the intrinsic
        // elements — box, text, span — via jsxImportSource; nothing does now.)
        "jsx": "react-jsx",
        "verbatimModuleSyntax": true
    },
    "include": ["src", "__tests__", "scripts"]
}
