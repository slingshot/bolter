{
    "name": "sendfm",
    "version": "0.1.1",
    "type": "module",
    "description": "Send and receive end-to-end encrypted files from the command line",
    "license": "MPL-2.0",
    "bin": {
        "sendfm": "./dist/sendfm"
    },
    "files": [
        "dist/"
    ],
    "scripts": {
        "dev": "bun run src/sendfm.ts",
        "build": "bun run scripts/build.ts",
        "build:all": "bun run scripts/build.ts --all",
        "build:binary": "bun run scripts/build.ts",
        "typecheck": "tsc --noEmit",
        "test": "bun test"
    },
    "dependencies": {
        "@bolter/protocol": "workspace:*",
        "@bolter/shared": "workspace:*",
        "ink": "^7.1.1",
        "react": "^19.2.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/react": "^19.2.18",
        "react-devtools-core": "file:./vendor/react-devtools-core",
        "typescript": "^5.9.3"
    }
}
